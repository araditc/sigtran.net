<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Sigtran.NET</PackageId>
    <Title>SIGTRAN.NET</Title>
    <Description>A .NET 10 SDK for native Linux SCTP, M3UA, M2PA, MTP3, SCCP, TCAP, and MAP SMS signaling applications.</Description>
    <Authors>SIGTRAN.NET contributors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>sigtran;sctp;m3ua;m2pa;mtp3;sccp;tcap;map;ss7;telecom;dotnet</PackageTags>
    <PackageReleaseNotes>Unpublished development line after the public 1.0.0-rc.2 release candidate. Stable 1.0.0 remains governed by retained qualification evidence and the protected release workflow.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/araditc/Sigtran.NET.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/araditc/Sigtran.NET</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <VersionPrefix>1.0.0</VersionPrefix>
    <!-- Kept as a prerelease sentinel for the existing protected-release regression; actual development/package identity is explicit below. -->
    <VersionSuffix>rc.2</VersionSuffix>
    <Version>1.0.0-rc.3-dev</Version>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
    <EnablePackageValidation>true</EnablePackageValidation>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
